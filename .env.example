# =============================================================================
# Faculty Workload Planning Agent — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# --- Application ---
FWP_ENV=development
FWP_DEBUG=true
FWP_API_PREFIX=/api/v1
FWP_APP_NAME=Faculty Workload Planning Agent

# --- Database (PostgreSQL) ---
FWP_DATABASE_URL=postgresql+asyncpg://fwp_user:fwp_password@127.0.0.1:15432/fwp_db
FWP_DATABASE_POOL_SIZE=10
FWP_DATABASE_ECHO=false

# --- Redis ---
FWP_REDIS_URL=redis://localhost:6379/0

# --- Security / JWT ---
FWP_JWT_SECRET=change-me-to-a-long-random-secret
FWP_JWT_ALGORITHM=HS256
FWP_JWT_EXPIRE_MINUTES=60
FWP_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FWP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optimization (OR-Tools CP-SAT) ---
FWP_SOLVER_TIMEOUT_SECONDS=120
FWP_SOLVER_MAX_WORKERS=4

# --- AI / LLM (optional — allocation does not depend on AI) ---
FWP_AI_PROVIDER=nim
FWP_AI_ENABLED=true
FWP_NIM_API_KEY=
FWP_NIM_BASE_URL=
FWP_OPENAI_API_KEY=
FWP_GROQ_API_KEY=

# --- Notifications ---
FWP_SMTP_HOST=
FWP_SMTP_PORT=587
FWP_SMTP_USER=
FWP_SMTP_PASSWORD=
FWP_SMTP_FROM=noreply@university.edu
FWP_SMTP_USE_TLS=true

# --- Observability ---
FWP_LOG_LEVEL=INFO
FWP_LOG_FORMAT=json
FWP_METRICS_ENABLED=true

# --- Frontend (build-time, prefix with VITE_) ---
# For local dev, set in frontend/.env (uses Vite proxy):
#   VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=/api/v1
